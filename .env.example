# Copia este arquivo pra .env.local e preenche.
# .env.local é gitignored — credenciais reais ficam só na sua máquina.

# Clerk (auth) — pegue em https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastre-se
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/painel
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/cadastre-se/onboarding

# Postgres (Neon) — pegue em https://console.neon.tech → Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require

# ZapSign — pegue em https://app.zapsign.com.br/conta/api
ZAPSIGN_API_TOKEN=

# Public site URL (para OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.antecipaqui.digital
